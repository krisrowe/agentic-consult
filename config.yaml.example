# agentic-consult/config.yaml
# Place this file in your customers root directory (e.g., alongside your customer folders).

# Default reminder window in minutes
reminder_minutes: 5

# Default directory for issue tracking files
issues_dir: ./issues

# Command to invoke Gemini CLI
gemini_cmd: gemini

# Gemini CLI Configuration
gemini:
  # Enable debug logging for the Gemini CLI (shows MCP/extension loading)
  debug: false

# Default TickTick project
ticktick_project: Work

# If true, `refresh` will echo the 'ticktick' commands instead of executing them.
# The generated `task-deltas.json` file will also be preserved.
skip_task_writes: true

# Use mock Gemini script for testing/development
use_mock_gemini: false

# Use mock input data (emails/tasks) if available in customer directory
use_mock_data: false

# Root Google Drive folder for all customer data backups
google_drive_all_customers_folder_id: "<DRIVE_PARENT_ID>"

# TickTick Authentication
ticktick:
  auth:
    # Set to true to allow falling back to ~/.gemini/settings.json for the access token
    # Default is false.
    use_gemini: false