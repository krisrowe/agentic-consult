#!/usr/bin/env python3
"""Show configured MCP tool docstrings.

Usage:
    python scripts/show-mcp-docstrings-config.py              # List tools
    python scripts/show-mcp-docstrings-config.py triage_emails  # Show docstring
"""

import json
import sys
from pathlib import Path


def main():
    path = Path(__file__).parent.parent / "agentic_consult" / "mcp" / "tool-docstrings.json"

    if not path.exists():
        print(f"Error: {path} not found", file=sys.stderr)
        sys.exit(1)

    with open(path) as f:
        docstrings = json.load(f)

    if len(sys.argv) < 2:
        print("Available tools:")
        for name in sorted(docstrings.keys()):
            print(f"  {name}")
        return

    tool = sys.argv[1]
    if tool not in docstrings:
        print(f"Error: '{tool}' not found. Available: {', '.join(sorted(docstrings.keys()))}", file=sys.stderr)
        sys.exit(1)

    print(docstrings[tool])


if __name__ == "__main__":
    main()
