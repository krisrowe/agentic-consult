openapi: 3.0.3
info:
  title: Agentic Consult MCP
  description: Public API Gateway for private MCP service
  version: 1.0.0

x-google-api-management:
  backends:
    mcp_backend:
      address: ${mcp_url}
      pathTranslation: APPEND_PATH_TO_ADDRESS
      protocol: "h2"

x-google-backend: mcp_backend

components:
  securitySchemes:
    api_key:
      type: apiKey
      name: key
      in: query

security:
  - api_key: []

paths:
  /:
    post:
      summary: MCP JSON-RPC Endpoint
      operationId: mcp_root
      responses:
        '200':
          description: OK
  /health:
    get:
      summary: Health Check
      operationId: health
      # Public health check
      security: []
      responses:
        '200':
          description: OK
  /internal/batch:
    post:
      summary: Batch Analysis
      operationId: batch
      responses:
        '200':
          description: OK