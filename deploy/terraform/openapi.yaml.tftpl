swagger: '2.0'
info:
  title: Agentic Consult MCP
  description: Public API Gateway for private MCP service
  version: 1.0.0
schemes:
  - https
produces:
  - application/json
paths:
  /:
    post:
      summary: MCP JSON-RPC Endpoint
      operationId: mcp_root
      x-google-backend:
        address: ${mcp_url}/
        jwt_audience: ${mcp_url}
        path_translation: CONSTANT_ADDRESS
        protocol: h2
      security:
        - api_key: []
      responses:
        '200':
          description: OK
  /health:
    get:
      summary: Health Check
      operationId: health
      x-google-backend:
        address: ${mcp_url}/health
        jwt_audience: ${mcp_url}
        path_translation: CONSTANT_ADDRESS
        protocol: h2
      # Public health check
      security: []
      responses:
        '200':
          description: OK
  /sse:
    get:
      summary: SSE Endpoint
      operationId: sse
      x-google-backend:
        address: ${mcp_url}/sse
        jwt_audience: ${mcp_url}
        path_translation: CONSTANT_ADDRESS
        protocol: h2
      security:
        - api_key: []
      responses:
        '200':
          description: OK
  /internal/batch:
    post:
      summary: Batch Analysis
      operationId: batch
      x-google-backend:
        address: ${mcp_url}/internal/batch
        jwt_audience: ${mcp_url}
        path_translation: CONSTANT_ADDRESS
        protocol: h2
      security:
        - api_key: []
      responses:
        '200':
          description: OK

securityDefinitions:
  # This configures API Gateway to validate the 'key' query parameter
  api_key:
    type: "apiKey"
    name: "key"
    in: "query"