{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Application Configuration Schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gemini": {
      "type": "object",
      "description": "Gemini API and Model Configuration",
      "additionalProperties": false,
      "properties": {
        "debug": { "type": "boolean", "description": "Enable debug logging for Gemini client" },
        "api_key": { "type": "string", "description": "Gemini API Key (overrides env var)" },
        "models": {
          "type": "object",
          "description": "Model selection settings",
          "additionalProperties": false,
          "properties": {
            "default": { "type": "string", "description": "Default model ID to use" },
            "available": {
              "type": "array",
              "description": "List of allowed/supported models",
              "items": { "type": "string" }
            }
          },
          "required": ["default", "available"]
        }
      }
    },
    "email": {
      "type": "object",
      "description": "Email Processing Settings",
      "additionalProperties": false,
      "properties": {
        "read_archived_email": { "type": "boolean", "description": "Whether to fetch archived emails" },
        "max_emails": { "type": "integer", "description": "Maximum number of emails to process per batch" },
        "max_prompt_content_chars": { "type": "integer", "description": "Max characters for email content in prompt" },
        "max_email_chars": { "type": "integer", "description": "Max characters per single email" },
        "archive_log_retention_days": { "type": "integer", "description": "Days to keep local archive logs" },
        "review_label": { "type": "string", "description": "Gmail label for items needing review" },
        "archivable_label": { "type": "string", "description": "Gmail label for items ready to archive" },
        "cache": {
          "type": "object",
          "description": "Email caching policy",
          "additionalProperties": false,
          "properties": {
            "email_max_age_days": { "type": "integer", "description": "Max age of cached emails" },
            "cleanup_file_age_days": { "type": "integer", "description": "Cleanup threshold for cache files" }
          }
        },
        "triage_table_widths": {
          "type": "object",
          "description": "Display widths for triage table",
          "additionalProperties": false,
          "properties": {
            "small": { "type": "integer" },
            "medium": { "type": "integer" },
            "large": { "type": "integer" }
          }
        }
      }
    },
    "analyze": {
      "type": "object",
      "description": "File Analysis Settings",
      "additionalProperties": false,
      "properties": {
        "max_file_count": { "type": "integer", "description": "Max files to analyze at once" },
        "max_total_content_bytes": { "type": "integer", "description": "Max total bytes for analysis context" },
        "max_text_size_kb": { "type": "integer", "description": "Max size for text files in KB" },
        "max_binary_size_kb": { "type": "integer", "description": "Max size for binary files in KB" }
      }
    },
    "use_mock_gemini": { "type": "boolean", "description": "Use mock responses for testing" },
    "tasks": {
      "type": "object",
      "description": "Task Provider Settings",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "description": "Task provider (e.g. ticktick)" },
        "cloud_sync": { "type": "boolean", "description": "Enable cloud sync for tasks" },
        "default_project": { "type": "string", "description": "Default project name for new tasks" }
      }
    },
    "precommit": {
      "type": "object",
      "description": "Pre-commit Security Scanner",
      "additionalProperties": false,
      "properties": {
        "fresh_threshold_days": { "type": "integer", "description": "Scan depth in days" },
        "strict_history_limit": { "type": "integer", "description": "Commits to scan in strict mode" },
        "check_git_identity": { "type": "boolean", "description": "Verify git author identity" },
        "git_local_user_identity_optional": { "type": "boolean", "description": "Allow missing local git config" },
        "allowed_emails": {
          "type": "array",
          "description": "Whitelisted emails for PII scanning",
          "items": { "type": "string" }
        }
      }
    },
    "workspace_analysis": {
      "type": "object",
      "description": "Workspace State Analysis",
      "additionalProperties": false,
      "properties": {
        "required_last_commits_match": { "type": "integer", "description": "Commits to match for sync check" },
        "required_total_match_percent": { "type": "integer", "description": "Percentage match required for sync" },
        "github_visibility_cache_duration": { "type": "string", "description": "Cache duration for repo visibility" }
      }
    },
    "chat": {
      "type": "object",
      "description": "Chat Triage Settings",
      "additionalProperties": false,
      "properties": {
        "triage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limit": { "type": "integer", "description": "Max spaces to scan" },
            "message_limit": { "type": "integer", "description": "Max total messages to analyze" },
            "disabled_email_pattern": { "type": "string", "description": "Regex to ignore specific accounts" },
            "implicit_mention_threshold": { "type": "integer", "description": "Member count threshold for implicit mentions" },
            "tiers": {
              "type": "array",
              "description": "Lookback rules based on space size",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "max_members": { "type": ["integer", "null"] },
                  "lookback_days": { "type": "integer" }
                }
              }
            }
          }
        }
      }
    }
  }
}
